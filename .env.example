# Environment Configuration
ENVIRONMENT=development
DEBUG=false

# Storage Backend Configuration
# Options: 'local' for filesystem, 's3' for AWS S3
STORAGE_BACKEND=local

# Local Storage Settings (when STORAGE_BACKEND=local)
LOCAL_STORAGE_PATH=./data

# AWS S3 Settings (when STORAGE_BACKEND=s3)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-west-2
S3_BUCKET_NAME=your-bucket-name

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/renewable_docs

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Monitoring and Metrics
METRICS_ENABLED=true
METRICS_API_KEY=your-metrics-api-key
LOG_LEVEL=INFO